<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApexPost</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">ApexPost Logistics</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Catalogue</a>
                <a class="nav-link" asp-controller="Counter" asp-action="Index">Counter</a>
                <a class="nav-link" asp-controller="Counter" asp-action="Transactions">Transactions</a>
                <a class="nav-link" asp-controller="Shipping" asp-action="ShippingLabel">Shipping label</a>
                <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>
                @if (User.HasClaim("Role", "Auditor"))
                {
                    <a class="nav-link" asp-controller="Reports" asp-action="Audit">Audit</a>
                }
                @if (User.HasClaim("Role", "Administrator"))
                {
                    <a class="nav-link" asp-controller="Staff" asp-action="Index">Staff</a>
                    <a class="nav-link" asp-controller="Branches" asp-action="Index">Branches</a>
                    <a class="nav-link" asp-controller="Products" asp-action="Index">Products</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-link nav-link" type="submit">Logout</button>
                    </form>
                }
            </div>
        </div>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
</body>
</html>
