@model ApexPost.Web.Models.MoneyOrderFormViewModel
@{
    ViewData["Title"] = "Money order";
}

<h2>Issue a money order</h2>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
<form asp-action="MoneyOrder" method="post">
    @Html.AntiForgeryToken()
    <partial name="_ValidationSummary" />
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="CounterId" class="form-label">Counter</label>
            <select asp-for="CounterId" class="form-select">
                @foreach (var counter in Model.Counters)
                {
                    <option value="@counter">@counter</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Amount" class="form-label">Amount (AUD)</label>
            <input asp-for="Amount" class="form-control" min="0.01" max="20000" step="0.01" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PaymentMethod" class="form-label">Payment method</label>
            <select asp-for="PaymentMethod" class="form-select">
                <option>Cash</option>
                <option>Card</option>
                <option>EFTPOS</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="Sender" class="form-label"></label>
            <input asp-for="Sender" class="form-control" />
            <span asp-validation-for="Sender" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Recipient" class="form-label"></label>
            <input asp-for="Recipient" class="form-control" />
            <span asp-validation-for="Recipient" class="text-danger"></span>
        </div>
    </div>
    <fieldset class="mb-3">
        <legend>Identity verification</legend>
        <p class="text-muted">Required for high-value money orders. Only the last four characters are retained.</p>
        <div class="form-check mb-3">
            <input asp-for="IncludeIdentityVerification" class="form-check-input" />
            <label asp-for="IncludeIdentityVerification" class="form-check-label">Perform identity verification</label>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="DocumentType" class="form-label">Document type</label>
                <select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<ApexPost.Domain.Enums.DocumentType>()" class="form-select"></select>
            </div>
            <div class="col-md-8">
                <label asp-for="DocumentNumber" class="form-label">Document number</label>
                <input asp-for="DocumentNumber" class="form-control" autocomplete="off" />
            </div>
        </div>
    </fieldset>
    <button type="submit" class="btn btn-primary">Issue money order</button>
</form>
