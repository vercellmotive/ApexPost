@model ApexPost.Web.Models.TransactionFormViewModel
@{
    ViewData["Title"] = "Counter";
    var products = ViewBag.Products as IEnumerable<ApexPost.Domain.Entities.Product> ?? [];
    var branches = ViewBag.Branches as IEnumerable<ApexPost.Domain.Entities.Branch> ?? [];
    var stocks = ViewBag.Stocks as IEnumerable<ApexPost.Domain.Entities.BranchStock> ?? [];
    var branchCode = branches.FirstOrDefault()?.Id.Value;
}

<h2>Counter transaction</h2>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
<form asp-action="Create" asp-controller="Counter" method="post">
    @Html.AntiForgeryToken()
    <partial name="_ValidationSummary" />
    <fieldset class="mb-4">
        <legend>Counter and retail items</legend>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CounterId" class="form-label">Counter</label>
                <select asp-for="CounterId" class="form-select">
                    @foreach (var branch in branches)
                    {
                        foreach (var counter in branch.CounterTerminals)
                        {
                            <option value="@counter">@counter</option>
                        }
                    }
                </select>
            </div>
        </div>
        @for (var index = 0; index < Model.RetailItems.Count; index++)
        {
            <div class="row g-3 mt-1">
                <div class="col-md-8">
                    <label asp-for="RetailItems[index].ProductSku" class="form-label">Product @(index + 1)</label>
                    <select asp-for="RetailItems[index].ProductSku" class="form-select">
                        <option value="">No item</option>
                        @foreach (var product in products)
                        {
                            var available = stocks.FirstOrDefault(item =>
                                item.BranchCode.Value == branchCode && item.ProductSku == product.Id)?.QuantityOnHand ?? 0;
                            if (available > 0)
                            {
                                <option value="@product.Id.Value">@product.Name — @product.UnitPrice.Amount.ToString("C") (stock: @available)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="RetailItems[index].Quantity" class="form-label">Quantity</label>
                    <input asp-for="RetailItems[index].Quantity" class="form-control" min="1" max="100" />
                    <span asp-validation-for="RetailItems[index].Quantity" class="text-danger"></span>
                </div>
            </div>
        }
    </fieldset>

    <fieldset class="mb-4">
        <legend>Shipping (optional)</legend>
        <p class="text-muted">Tick each shipment to include. Dimensions are ignored for letters.</p>
        @for (var index = 0; index < Model.Shipments.Count; index++)
        {
            <div class="row g-2 mb-3 align-items-end border-bottom pb-3">
                <div class="col-12 form-check ms-2">
                    <input asp-for="Shipments[index].Include" class="form-check-input" />
                    <label asp-for="Shipments[index].Include" class="form-check-label">Shipment @(index + 1)</label>
                </div>
                <div class="col-md-2">
                    <label asp-for="Shipments[index].IsParcel" class="form-label">Item type</label>
                    <select asp-for="Shipments[index].IsParcel" class="form-select">
                        <option value="true">Parcel</option>
                        <option value="false">Letter</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label asp-for="Shipments[index].WeightKg" class="form-label">Kg</label>
                    <input asp-for="Shipments[index].WeightKg" class="form-control" />
                </div>
                <div class="col-md-1">
                    <label asp-for="Shipments[index].LengthCm" class="form-label">L (cm)</label>
                    <input asp-for="Shipments[index].LengthCm" class="form-control" />
                </div>
                <div class="col-md-1">
                    <label asp-for="Shipments[index].WidthCm" class="form-label">W (cm)</label>
                    <input asp-for="Shipments[index].WidthCm" class="form-control" />
                </div>
                <div class="col-md-1">
                    <label asp-for="Shipments[index].HeightCm" class="form-label">H (cm)</label>
                    <input asp-for="Shipments[index].HeightCm" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Shipments[index].DestinationZone" class="form-label">Zone</label>
                    <select asp-for="Shipments[index].DestinationZone" class="form-select">
                        @for (var zone = 1; zone <= 10; zone++)
                        {
                            <option value="Zone @zone">Zone @zone</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Shipments[index].ServiceLevel" class="form-label">Service</label>
                    <select asp-for="Shipments[index].ServiceLevel" asp-items="Html.GetEnumSelectList<ApexPost.Domain.Enums.ServiceLevel>()" class="form-select"></select>
                </div>
            </div>
        }
    </fieldset>

    <fieldset class="mb-4">
        <legend>Money orders and identity verification (optional)</legend>
        <p class="text-muted">Identity verification is simulated by validating document format only; no external identity provider is contacted. The full number is not persisted. Leave unused money order rows empty.</p>
        @for (var index = 0; index < Model.MoneyOrders.Count; index++)
        {
            <div class="row g-3 mb-2">
                <div class="col-md-4">
                    <label asp-for="MoneyOrders[index].Amount" class="form-label">Money order @(index + 1) amount (AUD)</label>
                    <input asp-for="MoneyOrders[index].Amount" class="form-control" min="0" max="20000" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="MoneyOrders[index].Sender" class="form-label">Sender</label>
                    <input asp-for="MoneyOrders[index].Sender" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="MoneyOrders[index].Recipient" class="form-label">Recipient</label>
                    <input asp-for="MoneyOrders[index].Recipient" class="form-control" />
                </div>
            </div>
        }
        <div class="row g-3 mt-1">
            <div class="col-md-4 form-check ms-2">
                <input asp-for="IncludeIdentityVerification" class="form-check-input" />
                <label asp-for="IncludeIdentityVerification" class="form-check-label">Perform identity verification</label>
            </div>
            <div class="col-md-4">
                <label asp-for="DocumentType" class="form-label">Document type</label>
                <select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<ApexPost.Domain.Enums.DocumentType>()" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="DocumentNumber" class="form-label">Document number (only last four characters are retained)</label>
                <input asp-for="DocumentNumber" class="form-control" autocomplete="off" />
            </div>
        </div>
    </fieldset>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="PaymentMethod" class="form-label">Payment method</label>
            <select asp-for="PaymentMethod" class="form-select">
                <option>Cash</option>
                <option>Card</option>
                <option>EFTPOS</option>
            </select>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Complete transaction</button>
</form>
