@using ApexPost.Domain.ValueObjects
@{
    ViewData["Title"] = "Reports";
    var sales = ViewBag.Sales as IEnumerable<(string Branch, Money Sales, Money Services)> ?? [];
    var stock = ViewBag.Stock as IEnumerable<(string Branch, string Sku, int Quantity)> ?? [];
    var shipping = ViewBag.Shipping as IEnumerable<(string Zone, ApexPost.Domain.Enums.ServiceLevel ServiceLevel, int Count)> ?? [];
}

<h2>Reports</h2>
<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="date" class="form-label">Sales date</label>
        <input id="date" name="date" type="date" class="form-control" value="@(((DateOnly)ViewBag.ReportDate).ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Show</button></div>
</form>
<div class="row">
    <div class="col-md-6">
        <h3>Daily branch sales (@(((DateOnly)ViewBag.ReportDate).ToString("d MMM yyyy")))</h3>
        @if (!sales.Any())
        {
            <p class="text-muted">No paid sales on this date.</p>
        }
        <ul>
            @foreach (var item in sales)
            {
                <li>@item.Branch: retail @item.Sales.Amount.ToString("C"), services @item.Services.Amount.ToString("C")</li>
            }
        </ul>
    </div>
    <div class="col-md-6">
        <h3>Shipping volume by zone and service level</h3>
        <ul>
            @foreach (var item in shipping)
            {
                <li>@item.Zone / @item.ServiceLevel: @item.Count</li>
            }
        </ul>
    </div>
    <div class="col-md-6">
        <h3>Low stock (@ViewBag.LowStockThreshold units or fewer)</h3>
        <ul>
            @foreach (var item in stock)
            {
                <li>@item.Branch / @item.Sku: @item.Quantity</li>
            }
        </ul>
    </div>
</div>
