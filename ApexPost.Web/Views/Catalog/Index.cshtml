@model IReadOnlyList<ApexPost.Application.Queries.CatalogueRowDto>
@{
    ViewData["Title"] = "Catalogue";
}

<h2>Product catalogue</h2>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (User.HasClaim("Role", "Administrator"))
{
    <p><a class="btn btn-primary" asp-controller="Products" asp-action="Index">Manage products</a></p>
}
<table class="table table-striped">
    <thead>
        <tr><th>SKU</th><th>Name</th><th>Category</th><th>Price</th><th>Stock at your branch</th>@if (User.IsInRole("BranchManager")) { <th>Adjust stock</th> }</tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Sku</td>
                <td>@product.Name</td>
                <td>@product.Category</td>
                <td>@product.UnitPrice.ToString("C")</td>
                <td>@product.QuantityOnHand</td>
                @if (User.IsInRole("BranchManager"))
                {
                    <td>
                        <form asp-controller="Stock" asp-action="Adjust" method="post" class="d-flex flex-wrap gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productSku" value="@product.Sku" />
                            <label class="visually-hidden" for="quantity-@product.Sku">Stock quantity change</label>
                            <input id="quantity-@product.Sku" name="quantityDelta" type="number" class="form-control" required />
                            <label class="visually-hidden" for="reason-@product.Sku">Adjustment reason</label>
                            <select id="reason-@product.Sku" name="reasonCode" class="form-select">
                                @foreach (var reason in Enum.GetValues<ApexPost.Domain.Enums.StockAdjustmentReason>())
                                {
                                    <option value="@reason">@reason</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-primary">Apply</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
