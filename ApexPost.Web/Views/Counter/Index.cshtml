@model ApexPost.Web.Models.TransactionFormViewModel
@{
    ViewData["Title"] = "Counter";
    var products = ViewBag.Products as IEnumerable<ApexPost.Domain.Entities.Product> ?? [];
    var branches = ViewBag.Branches as IEnumerable<ApexPost.Domain.Entities.Branch> ?? [];
    var stocks = ViewBag.Stocks as IEnumerable<ApexPost.Domain.Entities.BranchStock> ?? [];
    var branchCode = branches.FirstOrDefault()?.Id.Value;
}

<h2>Counter transaction</h2>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
<form asp-action="Create" asp-controller="Counter" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <fieldset class="mb-4">
        <legend>Counter and retail items</legend>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CounterId" class="form-label"></label>
                <select asp-for="CounterId" class="form-select">
                    @foreach (var branch in branches)
                    {
                        foreach (var counter in branch.CounterTerminals)
                        {
                            <option value="@counter">@counter</option>
                        }
                    }
                </select>
            </div>
        </div>
        @for (var index = 0; index < Model.RetailItems.Count; index++)
        {
            <div class="row g-3 mt-1">
                <div class="col-md-8">
                    <label asp-for="RetailItems[index].ProductSku" class="form-label">Product @(index + 1)</label>
                    <select asp-for="RetailItems[index].ProductSku" class="form-select">
                        <option value="">No item</option>
                        @foreach (var product in products)
                        {
                            var available = stocks.FirstOrDefault(item =>
                                item.BranchCode.Value == branchCode && item.ProductSku == product.Id)?.QuantityOnHand ?? 0;
                            if (available > 0)
                            {
                                <option value="@product.Id.Value">@product.Name — @product.UnitPrice.Amount.ToString("C") (stock: @available)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="RetailItems[index].Quantity" class="form-label">Quantity</label>
                    <input asp-for="RetailItems[index].Quantity" class="form-control" min="1" max="100" />
                    <span asp-validation-for="RetailItems[index].Quantity" class="text-danger"></span>
                </div>
            </div>
        }
    </fieldset>

    <fieldset class="mb-4">
        <legend>Shipping service (optional)</legend>
        <div class="form-check mb-3">
            <input asp-for="IncludeShipping" class="form-check-input" />
            <label asp-for="IncludeShipping" class="form-check-label">Add shipping to this basket</label>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="IsParcel" class="form-label">Item type</label>
                <select asp-for="IsParcel" class="form-select">
                    <option value="true">Parcel</option>
                    <option value="false">Letter</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="ShippingWeightKg" class="form-label">Weight (kg)</label>
                <input asp-for="ShippingWeightKg" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="LengthCm" class="form-label">Length (cm)</label>
                <input asp-for="LengthCm" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="WidthCm" class="form-label">Width (cm)</label>
                <input asp-for="WidthCm" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="HeightCm" class="form-label">Height (cm)</label>
                <input asp-for="HeightCm" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="DestinationZone" class="form-label">Destination zone</label>
                <select asp-for="DestinationZone" class="form-select">
                    @for (var zone = 1; zone <= 10; zone++)
                    {
                        <option value="Zone @zone">Zone @zone</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="ServiceLevel" class="form-label"></label>
                <select asp-for="ServiceLevel" asp-items="Html.GetEnumSelectList<ApexPost.Domain.Enums.ServiceLevel>()" class="form-select"></select>
            </div>
        </div>
    </fieldset>

    <fieldset class="mb-4">
        <legend>Money order and identity verification (optional)</legend>
        <p class="text-muted">Identity verification is simulated by validating document format only; no external identity provider is contacted. The full number is not persisted.</p>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="MoneyOrderAmount" class="form-label">Money order amount (AUD)</label>
                <input asp-for="MoneyOrderAmount" class="form-control" min="0" max="20000" step="0.01" />
            </div>
            <div class="col-md-4">
                <label asp-for="Sender" class="form-label"></label>
                <input asp-for="Sender" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Recipient" class="form-label"></label>
                <input asp-for="Recipient" class="form-control" />
            </div>
            <div class="col-md-4 form-check ms-2">
                <input asp-for="IncludeIdentityVerification" class="form-check-input" />
                <label asp-for="IncludeIdentityVerification" class="form-check-label">Perform identity verification</label>
            </div>
            <div class="col-md-4">
                <label asp-for="DocumentType" class="form-label"></label>
                <select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<ApexPost.Domain.Enums.DocumentType>()" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="DocumentNumber" class="form-label">Document number (only last four characters are retained)</label>
                <input asp-for="DocumentNumber" class="form-control" autocomplete="off" />
            </div>
        </div>
    </fieldset>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="PaymentMethod" class="form-label"></label>
            <select asp-for="PaymentMethod" class="form-select">
                <option>Cash</option>
                <option>Card</option>
                <option>EFTPOS</option>
            </select>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Complete transaction</button>
</form>
