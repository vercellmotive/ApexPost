@model ApexPost.Web.Models.ShippingLabelViewModel
@{
    ViewData["Title"] = "Shipping label preview";
}

<h2>Shipping label preview</h2>
<form asp-action="ShippingLabel" method="post">
    @Html.AntiForgeryToken()
    <partial name="_ValidationSummary" />
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="IsParcel" class="form-label">Item type</label>
            <select asp-for="IsParcel" class="form-select">
                <option value="true">Parcel</option>
                <option value="false">Letter</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="WeightKg" class="form-label">Weight (kg)</label>
            <input asp-for="WeightKg" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="LengthCm" class="form-label">Length (cm)</label>
            <input asp-for="LengthCm" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="WidthCm" class="form-label">Width (cm)</label>
            <input asp-for="WidthCm" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="HeightCm" class="form-label">Height (cm)</label>
            <input asp-for="HeightCm" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="DestinationZone" class="form-label">Destination zone</label>
            <select asp-for="DestinationZone" class="form-select">
                @for (var zone = 1; zone <= 10; zone++)
                {
                    <option value="Zone @zone">Zone @zone</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="ServiceLevel" class="form-label"></label>
            <select asp-for="ServiceLevel" asp-items="Html.GetEnumSelectList<ApexPost.Domain.Enums.ServiceLevel>()" class="form-select"></select>
        </div>
    </div>
    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <label asp-for="RecipientName" class="form-label">Recipient</label>
            <input asp-for="RecipientName" class="form-control" />
        </div>
        <div class="col-md-8">
            <label asp-for="Street" class="form-label"></label>
            <input asp-for="Street" class="form-control" />
        </div>
        <div class="col-md-5">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="PostalCode" class="form-label">Postcode</label>
            <input asp-for="PostalCode" class="form-control" />
        </div>
    </div>
    <p class="form-text">Dimensions are required for parcels and ignored for letters (letters are limited to 0.5 kg).</p>
    <button type="submit" class="btn btn-primary mt-3">Calculate and preview</button>
</form>

@if (Model.Price is decimal price)
{
    <section class="border rounded p-4 mt-4" aria-label="Shipping label">
        <h3>ApexPost Logistics</h3>
        <p>@(Model.IsParcel ? "Parcel" : "Letter") · @Model.ServiceLevel · @Model.DestinationZone</p>
        <address>
            <strong>@Model.RecipientName</strong><br />
            @Model.DestinationAddress.Street<br />
            @Model.DestinationAddress.City @Model.DestinationAddress.State @Model.DestinationAddress.PostalCode<br />
            @Model.DestinationAddress.Country
        </address>
        <p>Weight: @Model.WeightKg kg</p>
        <p class="fw-bold">Price: @price.ToString("C")</p>
    </section>
}
