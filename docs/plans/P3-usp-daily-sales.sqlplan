<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT&#xa;        t.BranchCode,&#xa;        CAST(SUM(CASE WHEN l.LineType = &apos;RetailProduct&apos; THEN l.LineTotal ELSE 0 END) AS decimal(18,2)) AS RetailTotal,&#xa;        CAST(SUM(CASE&#xa;            WHEN l.LineType = &apos;RetailProduct&apos; THEN 0&#xa;            WHEN l.LineType = &apos;MoneyOrder&apos; THEN m.Fee&#xa;            ELSE l.LineTotal END) AS decimal(18,2)) AS ServicesTotal&#xa;    FROM dbo.CounterTransactions AS t&#xa;    INNER JOIN dbo.TransactionLines AS l ON l.TransactionId = t.Id&#xa;    LEFT JOIN dbo.MoneyOrders AS m ON m.TransactionLineId = l.Id&#xa;    WHERE t.BusinessDate = @Date&#xa;      AND t.Status = &apos;Paid&apos;&#xa;      AND (@BranchCode IS NULL OR t.BranchCode = @BranchCode)&#xa;    GROUP BY t.BranchCode&#xa;    ORDER BY t.BranchCode&#xa;    OPTION (RECOMPILE)" StatementId="2" StatementCompId="15" StatementType="SELECT" StatementSqlHandle="0x0900D2FB5192D563E739D9FEA8342DF0DB420000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="946102411" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="0.0164348" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x02A8E798AD147006" QueryPlanHash="0x93CA88E7352BC7E5" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1024" CachedPlanSize="80" CompileTime="6" CompileCPU="6" CompileMemory="912"><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="544" RequiredMemory="512" DesiredMemory="544" RequestedMemory="1024" GrantWaitTime="0" MaxQueryMemory="367536" GrantedMemory="1024" MaxUsedMemory="16" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="40128" EstimatedPagesCached="20064" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="1292096"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-31T07:23:04.66" ModificationCount="0" SamplingPercent="100" Statistics="[IX_CounterTransactions_Branch_Date]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-31T07:27:45.79" ModificationCount="0" SamplingPercent="100" Statistics="[IX_MoneyOrders_TransactionLineId]" Table="[MoneyOrders]" Schema="[dbo]" Database="[ApexPostDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-31T07:22:56.05" ModificationCount="0" SamplingPercent="30.1587" Statistics="[_WA_Sys_00000003_7F2BE32F]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-31T07:22:04.79" ModificationCount="0" SamplingPercent="21.6184" Statistics="[UQ_TransactionLines_Transaction_Number]" Table="[TransactionLines]" Schema="[dbo]" Database="[ApexPostDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-31T07:27:45.80" ModificationCount="0" SamplingPercent="100" Statistics="[PK_MoneyOrders]" Table="[MoneyOrders]" Schema="[dbo]" Database="[ApexPostDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-31T07:22:04.56" ModificationCount="0" SamplingPercent="29.6833" Statistics="[_WA_Sys_00000007_7F2BE32F]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-31T07:22:04.36" ModificationCount="0" SamplingPercent="31.6225" Statistics="[IX_CounterTransactions_VoidedByStaffId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb]"></Statis